<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F8F9FA"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WCST Instructions"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#1976D2"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp">

        <TextView
            android:id="@+id/tvWcstInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:textColor="#263238"
            android:text="In this test, you must sort the cards from the deck into one of the four categories shown at the top.\n\nYou are not told the sorting rule, but the system will tell you if you are 'Correct' or 'Incorrect' after each move.\n\nUse this feedback to figure out the current rule. Be careful, the rule may change without warning once you have mastered it." />
    </com.google.android.material.card.MaterialCardView>

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartWcstGame"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="I Understand - Start Test"
        app:cornerRadius="12dp"
        android:layout_marginBottom="32dp" />

</LinearLayout>