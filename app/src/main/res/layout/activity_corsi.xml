<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Watch carefully..."
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View android:id="@+id/block1" android:layout_width="85dp" android:layout_height="85dp"
        android:background="@drawable/block_default"
        app:layout_constraintHorizontal_bias="0.1" app:layout_constraintVertical_bias="0.2"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <View android:id="@+id/block2" android:layout_width="85dp" android:layout_height="85dp"
        android:background="@drawable/block_default"
        app:layout_constraintHorizontal_bias="0.8" app:layout_constraintVertical_bias="0.15"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <View android:id="@+id/block3" android:layout_width="85dp" android:layout_height="85dp"
        android:background="@drawable/block_default"
        app:layout_constraintHorizontal_bias="0.45" app:layout_constraintVertical_bias="0.35"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <View android:id="@+id/block4" android:layout_width="85dp" android:layout_height="85dp"
        android:background="@drawable/block_default"
        app:layout_constraintHorizontal_bias="0.15" app:layout_constraintVertical_bias="0.55"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <View android:id="@+id/block5" android:layout_width="85dp" android:layout_height="85dp"
        android:background="@drawable/block_default"
        app:layout_constraintHorizontal_bias="0.55" app:layout_constraintVertical_bias="0.6"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <View android:id="@+id/block6" android:layout_width="85dp" android:layout_height="85dp"
        android:background="@drawable/block_default"
        app:layout_constraintHorizontal_bias="0.9" app:layout_constraintVertical_bias="0.5"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <View android:id="@+id/block7" android:layout_width="85dp" android:layout_height="85dp"
        android:background="@drawable/block_default"
        app:layout_constraintHorizontal_bias="0.3" app:layout_constraintVertical_bias="0.85"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <View android:id="@+id/block8" android:layout_width="85dp" android:layout_height="85dp"
        android:background="@drawable/block_default"
        app:layout_constraintHorizontal_bias="0.85" app:layout_constraintVertical_bias="0.8"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <View android:id="@+id/block9" android:layout_width="85dp" android:layout_height="85dp"
        android:background="@drawable/block_default"
        app:layout_constraintHorizontal_bias="0.65" app:layout_constraintVertical_bias="0.95"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>