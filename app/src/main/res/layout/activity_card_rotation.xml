<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:background="#ECEFF1">

    <TextView
        android:id="@+id/questionStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:layout_marginBottom="24dp" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Reference Shape" android:textStyle="bold" />

    <ImageView
        android:id="@+id/targetCard"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/card_original"
        android:layout_marginBottom="32dp" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Is the shape below a rotation or mirrored?" android:textAlignment="center" />

    <ImageView
        android:id="@+id/optionCard"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/btnSame"
        android:layout_width="220dp"
        android:layout_height="60dp"
        android:text="Rotation (Same)"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnDifferent"
        android:layout_width="220dp"
        android:layout_height="60dp"
        android:text="Mirrored (Different)" />

</LinearLayout>